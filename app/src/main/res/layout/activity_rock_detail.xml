<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinatorLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".ui.activities.RockDetailActivity">

    <!-- AppBar with seamless flat white Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarRockDetail"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#FFFFFF"
            android:title="@string/rock_details"
            app:titleTextColor="#1A202C"
            app:navigationIconTint="#1A202C"
            app:popupTheme="@style/ThemeOverlay.MaterialComponents.Light" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- ScrollView for clean typography-focused content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="#FFFFFF"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/llContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="#FFFFFF">

            <!-- Premium Specimen Image Card with soft border and clean round corners -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E2E8F0"
                app:cardBackgroundColor="#FFFFFF">

                <ImageView
                    android:id="@+id/ivRockImage"
                    android:layout_width="match_parent"
                    android:layout_height="260dp"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/rock_image"
                    tools:src="@mipmap/ic_launcher" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Premium Slate-Black Specimen Title -->
            <TextView
                android:id="@+id/tvRockTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="26sp"
                android:fontFamily="@font/ubuntu_bold"
                android:textColor="#1A202C"
                android:layout_marginBottom="8dp"
                tools:text="Granito Adamellite" />

            <!-- Clean, elegant divider line -->
            <View
                android:layout_width="60dp"
                android:layout_height="3dp"
                android:background="#7B7D7D"
                android:layout_marginBottom="20dp" />

            <!-- Muted geographical and material metadata details -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="24dp"
                android:background="#F8FAFC"
                android:backgroundTint="#F8FAFC">

                <TextView
                    android:id="@+id/tvRockType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:fontFamily="@font/ubuntu_bold"
                    android:textColor="#4A5568"
                    android:layout_marginBottom="6dp"
                    tools:text="Corte: Sí | Lámina: No" />

                <TextView
                    android:id="@+id/tvRockColor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:fontFamily="@font/ubuntu"
                    android:textColor="#4A5568"
                    tools:text="Localidad: England" />
            </LinearLayout>

            <!-- Section Label for Description -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:fontFamily="@font/ubuntu_bold"
                android:textColor="#7B7D7D"
                android:text="DESCRIPCIÓN"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp" />

            <!-- Charcoal highly legible Description text -->
            <TextView
                android:id="@+id/tvRockDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#2D3748"
                android:textSize="16sp"
                android:fontFamily="@font/ubuntu"
                android:lineSpacingExtra="6dp"
                tools:text="A type of intrusive igneous rock with a composition between granite and diorite..." />

        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
