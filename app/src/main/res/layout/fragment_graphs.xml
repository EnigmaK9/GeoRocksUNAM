<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Title Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Estadísticas de Yacimientos"
            android:textSize="26sp"
            android:fontFamily="@font/ubuntu_bold"
            android:textColor="#1A202C"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Distribución y composición física de los especímenes en el sistema."
            android:textSize="15sp"
            android:fontFamily="@font/ubuntu"
            android:textColor="#7B7D7D"
            android:layout_marginBottom="28dp" />

        <!-- Total Specimen Summary Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#E2E8F0"
            app:cardBackgroundColor="#F8FAFC">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Muestras Catalogadas"
                    android:textSize="14sp"
                    android:fontFamily="@font/ubuntu_bold"
                    android:textColor="#7B7D7D"
                    android:letterSpacing="0.1" />

                <TextView
                    android:id="@+id/tvTotalSamplesCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="100"
                    android:textSize="48sp"
                    android:fontFamily="@font/ubuntu_bold"
                    android:textColor="#1A202C"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Chart 1: Cut Section Distribution -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MUESTRAS CON CORTE DE EXHIBICIÓN"
            android:textSize="13sp"
            android:fontFamily="@font/ubuntu_bold"
            android:textColor="#7B7D7D"
            android:letterSpacing="0.1"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:orientation="horizontal"
            android:weightSum="100"
            android:layout_marginBottom="8dp">

            <!-- YES Segment (52%) -->
            <View
                android:id="@+id/viewCutYes"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="52"
                android:background="#1A202C" />

            <!-- NO Segment (48%) -->
            <View
                android:id="@+id/viewCutNo"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="48"
                android:background="#E2E8F0" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="28dp">

            <!-- YES Label -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="start|center_vertical">
                <View
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="#1A202C"
                    android:layout_marginEnd="6dp" />
                <TextView
                    android:id="@+id/tvCutYesText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Con Corte: 52%"
                    android:textSize="13sp"
                    android:fontFamily="@font/ubuntu"
                    android:textColor="#4A5568" />
            </LinearLayout>

            <!-- NO Label -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="end|center_vertical">
                <View
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="#E2E8F0"
                    android:layout_marginEnd="6dp" />
                <TextView
                    android:id="@+id/tvCutNoText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sin Corte: 48%"
                    android:textSize="13sp"
                    android:fontFamily="@font/ubuntu"
                    android:textColor="#4A5568" />
            </LinearLayout>
        </LinearLayout>


        <!-- Chart 2: Thin Section Distribution -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MUESTRAS CON ESTUDIO DE LÁMINA DELGADA"
            android:textSize="13sp"
            android:fontFamily="@font/ubuntu_bold"
            android:textColor="#7B7D7D"
            android:letterSpacing="0.1"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:orientation="horizontal"
            android:weightSum="100"
            android:layout_marginBottom="8dp">

            <!-- YES Segment (26%) -->
            <View
                android:id="@+id/viewThinYes"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="26"
                android:background="#7B7D7D" />

            <!-- NO Segment (74%) -->
            <View
                android:id="@+id/viewThinNo"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="74"
                android:background="#F1F5F9" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <!-- YES Label -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="start|center_vertical">
                <View
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="#7B7D7D"
                    android:layout_marginEnd="6dp" />
                <TextView
                    android:id="@+id/tvThinYesText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Con Lámina: 26%"
                    android:textSize="13sp"
                    android:fontFamily="@font/ubuntu"
                    android:textColor="#4A5568" />
            </LinearLayout>

            <!-- NO Label -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="end|center_vertical">
                <View
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="#F1F5F9"
                    android:layout_marginEnd="6dp" />
                <TextView
                    android:id="@+id/tvThinNoText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sin Lámina: 74%"
                    android:textSize="13sp"
                    android:fontFamily="@font/ubuntu"
                    android:textColor="#4A5568" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
