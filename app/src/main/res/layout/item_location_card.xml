<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E2E8F0"
    app:cardBackgroundColor="#F8FAFC"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp"
        android:gravity="center_vertical">

        <!-- Flag icon placeholder or world icon -->
        <ImageView
            android:id="@+id/ivLocationFlag"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_directions"
            app:tint="#4A5568"
            android:layout_marginEnd="16dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Country name -->
            <TextView
                android:id="@+id/tvCountryName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Escocia"
                android:textSize="18sp"
                android:fontFamily="@font/ubuntu_bold"
                android:textColor="#1A202C" />

            <!-- City/Region name -->
            <TextView
                android:id="@+id/tvCityName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sutherlandshire"
                android:textSize="13sp"
                android:fontFamily="@font/ubuntu"
                android:textColor="#4A5568" />
        </LinearLayout>

        <!-- Dynamic specimen count -->
        <TextView
            android:id="@+id/tvLocationSamplesCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1 muestra"
            android:textSize="12sp"
            android:fontFamily="@font/ubuntu_bold"
            android:textColor="#1A202C"
            android:background="#E2E8F0"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
