<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- AppBar with flat white Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarLocations"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#FFFFFF"
            android:title="Explorador de Yacimientos"
            app:titleTextColor="#1A202C"
            app:navigationIconTint="#1A202C" />
    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Info Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Yacimientos del Mundo"
            android:textSize="24sp"
            android:fontFamily="@font/ubuntu_bold"
            android:textColor="#1A202C"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Explora las rocas recolectadas clasificadas por ubicación geográfica y país de origen."
            android:textSize="15sp"
            android:fontFamily="@font/ubuntu"
            android:textColor="#7B7D7D"
            android:layout_marginBottom="24dp" />

        <!-- Loading spinner -->
        <ProgressBar
            android:id="@+id/pbLocationsLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="#1A202C"
            android:visibility="gone" />

        <!-- Locations Recycler -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvLocations"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:listitem="@layout/item_location_card" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
